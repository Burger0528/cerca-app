{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // `@cerca/contract` viaja como TypeScript sin compilar (lo transpila Metro), y dentro
    // usa extensiones explícitas para que su build de Node ESM sea válido. Sin esto, tsc
    // se queja de los imports DEL PAQUETE, no de los nuestros.
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsxImportSource": "nativewind",
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "ios", "android", ".expo", "dist"]
}
